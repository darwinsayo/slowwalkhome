<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ summary or site.description }}">
  <meta name="author" content="{{ site.author }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  {%- set pageTitle = title if (title and page.url != "/") else site.title %}
  {%- set pageDesc = summary or site.description %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/images/social-card.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Slow Walk Home: a winding path over green hills to a small house at sunset">
  <meta name="twitter:card" content="summary_large_image">
</head>
<body>
  <header class="masthead">
    <div class="brand">
      <a class="wordmark" href="/">Slow Walk Home</a>
      <p class="tagline">{{ site.tagline }} · by {{ site.author }}</p>
    </div>
    <nav aria-label="Main">
      <a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Journal</a>
      <a href="/about/" {% if page.url == "/about/" %}aria-current="page"{% endif %}>About</a>
    </nav>
  </header>

  {% if hero %}{% include "hero.njk" %}{% endif %}

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>&copy; {{ "" | year }} {{ site.author }} · slowwalkhome.com</p>
  </footer>
</body>
</html>
