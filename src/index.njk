---
layout: base.njk
title: Journal
hero: true
---
<h2 class="section-label">Recent reflections</h2>

<ol class="post-list" reversed>
{% for post in collections.posts %}
  <li>
    <article>
      <p class="meta">
        <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
        {% if post.data.category %}<span class="dot">·</span> {{ post.data.category }}{% endif %}
      </p>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      {% if post.data.summary %}<p class="summary">{{ post.data.summary }}</p>{% endif %}
      <a class="more" href="{{ post.url }}">Continue reading <span aria-hidden="true">&rarr;</span></a>
    </article>
  </li>
{% else %}
  <li class="empty">The first steps are still being written.</li>
{% endfor %}
</ol>
